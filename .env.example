# ==============================================================================
# Configuración del Portal CURZA UNCo - Plantilla de Variables de Entorno
# ==============================================================================

# URL Base y Puerto del Portal
# Para desarrollo/pruebas locales:
SITE_URL=http://air.local:8888
PUBLIC_SITE_URL=http://air.local:8888

# Reverse Proxy (Caddy)
# Para desarrollo/pruebas locales:
CADDY_PORT=8888
CADDY_INTERNAL_PORT=8888
SITE_ADDRESS=:8888

# Para producción (descomentar y ajustar):
# SITE_URL=https://web.curza.uncoma.edu.ar
# PUBLIC_SITE_URL=https://web.curza.uncoma.edu.ar
# CADDY_PORT=80
# CADDY_INTERNAL_PORT=80
# SITE_ADDRESS=web.curza.uncoma.edu.ar

# Base de datos PostgreSQL para Strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=strapi_secure_pwd
POSTGRES_DB=curza_cms

# Strapi CMS
JWT_SECRET=changeme_secret_jwt
ADMIN_JWT_SECRET=changeme_secret_admin
APP_KEYS=key1,key2
API_TOKEN_SALT=salt_key
TRANSFER_TOKEN_SALT=transfer_salt

# Meilisearch
MEILISEARCH_MASTER_KEY=meili_master_key_curza
MEILISEARCH_SEARCH_KEY=meili_master_key_curza

# Servicio RAG
OLLAMA_EXTERNAL_URL=https://ollama.curza.com.ar/v1
OLLAMA_MODEL=gemma4:12b
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
