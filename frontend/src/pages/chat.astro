---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Asistente Virtual IA - CURZAS UNComa">
  <div class="max-w-4xl mx-auto px-3 sm:px-6 py-3 sm:py-4 flex flex-col h-[calc(100vh-9.5rem)] min-h-[460px]">
    <!-- Header Chat -->
    <div class="flex items-center justify-between pb-2.5 border-b border-slate-200 mb-3 flex-shrink-0">
      <div>
        <div class="inline-block text-[10px] font-bold text-[#F39200] uppercase tracking-wider">Servicio Digital</div>
        <h1 class="text-base sm:text-lg font-bold text-[#003366] leading-tight">Asistente Virtual Institucional</h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Consultas orientativas fundamentadas en resoluciones, planes y documentación oficial de CURZAS.
        </p>
      </div>

      <button id="clear-chat" class="text-xs text-slate-400 hover:text-slate-600 transition px-2 py-1 rounded hover:bg-slate-100">
        Limpiar chat
      </button>
    </div>

    <!-- Área de Mensajes -->
    <div id="chat-messages" class="flex-grow overflow-y-auto space-y-2.5 pr-2 pb-2 scroll-smooth">
      <!-- Mensaje Inicial del Asistente -->
      <div class="flex items-start gap-2.5">
        <div class="w-6 h-6 rounded-full bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5 overflow-hidden p-0.5">
          <img src="/images/CURZAS.png" alt="IA" class="w-full h-full object-contain" />
        </div>
        <div class="bg-white border border-slate-200 rounded-xl rounded-tl-none px-3.5 py-2.5 max-w-3xl shadow-sm text-xs sm:text-sm text-slate-800 leading-snug">
          <p class="mb-2">¡Hola! Soy el asistente institucional del CURZAS (UNComa). Puedo orientarte sobre carreras, inscripciones, fechas de examen, normativas y vida estudiantil.</p>
          <div class="pt-2 border-t border-slate-100 flex flex-wrap items-center gap-1.5 text-xs">
            <span class="text-slate-400 text-[11px]">Consultas frecuentes:</span>
            <button class="suggest-btn text-[#003366] bg-[#F0F5FA] hover:bg-[#003366] hover:text-white border border-slate-200/80 px-2 py-0.5 rounded transition text-xs">
              ¿Qué carreras se dictan en CURZAS?
            </button>
            <button class="suggest-btn text-[#003366] bg-[#F0F5FA] hover:bg-[#003366] hover:text-white border border-slate-200/80 px-2 py-0.5 rounded transition text-xs">
              ¿Cómo realizo trámites en el Departamento de Alumnos?
            </button>
            <button class="suggest-btn text-[#003366] bg-[#F0F5FA] hover:bg-[#003366] hover:text-white border border-slate-200/80 px-2 py-0.5 rounded transition text-xs">
              ¿Cuáles son los requisitos de ingreso?
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Box -->
    <div class="pt-2.5 border-t border-slate-200 flex-shrink-0">
      <form id="chat-form" class="relative flex items-center">
        <textarea 
          id="chat-input"
          rows="1"
          placeholder="Escribí tu consulta institucional aquí..."
          class="w-full resize-none rounded-lg border border-slate-300 pl-3.5 pr-24 py-2.5 text-xs sm:text-sm focus:border-[#F39200] focus:ring-1 focus:ring-[#F39200] outline-none shadow-sm bg-white"
          required
        ></textarea>
        <button 
          type="submit" 
          id="send-btn"
          class="absolute right-1.5 px-3 py-1.5 bg-[#003366] hover:bg-[#01579B] text-white font-medium rounded-md text-xs sm:text-sm transition shadow-sm flex items-center gap-1 border border-[#002244]"
        >
          <span>Enviar</span>
          <svg class="w-3.5 h-3.5 text-[#FFBC7D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>
      <div class="text-[10px] text-slate-400 text-center mt-1">
        Respuestas generadas en base a resoluciones y documentación institucional de CURZAS - UNComa.
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLTextAreaElement;
    const messagesContainer = document.getElementById('chat-messages') as HTMLDivElement;
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear-chat') as HTMLButtonElement;

    // Historial de la conversación para soporte multi-turno
    interface ChatHistoryItem {
      role: 'user' | 'assistant';
      content: string;
    }
    const conversationHistory: ChatHistoryItem[] = [];

    // Sugerencias de botones
    document.querySelectorAll('.suggest-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        input.value = (btn.textContent || '').trim();
        form.dispatchEvent(new Event('submit'));
      });
    });

    clearBtn?.addEventListener('click', () => {
      conversationHistory.length = 0;
      window.location.reload();
    });

    // Enviar con Enter (sin shift)
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.dispatchEvent(new Event('submit'));
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const prompt = input.value.trim();
      if (!prompt) return;

      input.value = '';
      input.disabled = true;
      sendBtn.disabled = true;

      // 1. Renderizar mensaje del usuario
      appendUserMessage(prompt);
      scrollToBottom();

      // 2. Renderizar indicador de carga inicial
      const loadingId = appendLoadingMessage();
      scrollToBottom();

      try {
        const res = await fetch('/api/rag/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            prompt,
            history: conversationHistory.slice(-6),
            stream: true
          })
        });

        if (!res.ok) {
          removeLoadingMessage(loadingId);
          throw new Error(`Error en servicio RAG (${res.status})`);
        }

        const contentType = res.headers.get('content-type') || '';

        // Fallback a respuesta JSON normal si el backend no envía stream
        if (contentType.includes('application/json')) {
          removeLoadingMessage(loadingId);
          const data = await res.json();
          appendAssistantMessage(data.answer, data.sources || []);
          conversationHistory.push({ role: 'user', content: prompt });
          conversationHistory.push({ role: 'assistant', content: data.answer });
          return;
        }

        // Manejo de Streaming SSE en tiempo real
        const reader = res.body?.getReader();
        if (!reader) {
          removeLoadingMessage(loadingId);
          throw new Error('No se pudo inicializar la lectura en tiempo real.');
        }

        let streamingMsg: ReturnType<typeof createStreamingAssistantMessage> | null = null;
        const decoder = new TextDecoder();
        let buffer = '';
        let fullText = '';
        let sources: string[] = [];

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() || '';

          for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed.startsWith('data: ')) continue;
            const dataStr = trimmed.slice(6).trim();
            if (!dataStr || dataStr === '[DONE]') continue;

            try {
              const event = JSON.parse(dataStr);
              if (event.type === 'sources') {
                sources = event.sources || [];
                if (!streamingMsg) {
                  removeLoadingMessage(loadingId);
                  streamingMsg = createStreamingAssistantMessage();
                }
                streamingMsg.setSources(sources);
                scrollToBottom();
              } else if (event.type === 'token') {
                if (!streamingMsg) {
                  removeLoadingMessage(loadingId);
                  streamingMsg = createStreamingAssistantMessage();
                }
                fullText += event.token;
                streamingMsg.appendChunk(fullText);
                scrollToBottom();
              } else if (event.type === 'error') {
                throw new Error(event.error);
              } else if (event.type === 'done') {
                if (streamingMsg) streamingMsg.finalize(fullText);
              }
            } catch (jsonErr: any) {
              // Ignorar fragmentos parciales si los hubiera
            }
          }
        }

        if (streamingMsg) {
          streamingMsg.finalize(fullText);
        } else {
          removeLoadingMessage(loadingId);
          appendAssistantMessage(fullText || 'Sin respuesta del modelo.', sources);
        }

        if (fullText) {
          conversationHistory.push({ role: 'user', content: prompt });
          conversationHistory.push({ role: 'assistant', content: fullText });
        }

      } catch (err: any) {
        removeLoadingMessage(loadingId);
        appendErrorMessage(err.message || 'No se pudo comunicar con el servicio de IA.');
      } finally {
        input.disabled = false;
        sendBtn.disabled = false;
        input.focus();
        scrollToBottom();
      }
    });

    function createStreamingAssistantMessage() {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start gap-2.5';

      const avatarDiv = document.createElement('div');
      avatarDiv.className = 'w-6 h-6 rounded-full bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5 overflow-hidden p-0.5';
      avatarDiv.innerHTML = '<img src="/images/CURZAS.png" alt="IA" class="w-full h-full object-contain" />';

      const bubbleDiv = document.createElement('div');
      bubbleDiv.className = 'bg-white border border-slate-200 rounded-xl rounded-tl-none px-3.5 py-2.5 max-w-3xl shadow-sm text-xs sm:text-sm text-slate-800 leading-snug';

      const contentDiv = document.createElement('div');
      contentDiv.className = 'assistant-content';
      bubbleDiv.appendChild(contentDiv);

      const sourcesDiv = document.createElement('div');
      sourcesDiv.className = 'sources-container mt-2 pt-1.5 border-t border-slate-100 hidden';
      bubbleDiv.appendChild(sourcesDiv);

      msgDiv.appendChild(avatarDiv);
      msgDiv.appendChild(bubbleDiv);
      messagesContainer.appendChild(msgDiv);

      return {
        appendChunk: (text: string) => {
          contentDiv.innerHTML = formatAssistantContent(text) + '<span class="inline-block w-1.5 h-3 bg-[#003366] ml-1 align-baseline animate-pulse"></span>';
        },
        setSources: (sourcesList: string[]) => {
          if (!sourcesList || sourcesList.length === 0) return;
          const uniqueSources = Array.from(new Set(sourcesList.filter(Boolean)));
          if (uniqueSources.length === 0) return;

          sourcesDiv.classList.remove('hidden');
          sourcesDiv.innerHTML = `
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block mb-1">Fuentes de verificación:</span>
            <div class="flex flex-wrap gap-1">
              ${uniqueSources.map(s => {
                const isLocal = s.startsWith('/contenido/');
                const label = isLocal ? `Doc. ${s.replace('/contenido/', '')}` : s;
                return `
                  <a href="${s}" class="inline-flex items-center gap-1 text-[11px] text-[#003366] bg-[#F0F5FA] hover:bg-[#E2EDF8] border border-[#01579B]/20 px-2 py-0.5 rounded transition">
                    <svg class="w-3 h-3 text-[#01579B] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    ${escapeHtml(label)}
                  </a>
                `;
              }).join('')}
            </div>
          `;
        },
        finalize: (finalText: string) => {
          contentDiv.innerHTML = formatAssistantContent(finalText);
        }
      };
    }

    function appendUserMessage(text: string) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start justify-end gap-2.5';
      msgDiv.innerHTML = `
        <div class="bg-[#003366] text-white rounded-xl rounded-tr-none px-3.5 py-2 max-w-2xl shadow-sm text-xs sm:text-sm leading-snug whitespace-pre-wrap border border-[#002244]">
          ${escapeHtml(text)}
        </div>
        <div class="w-6 h-6 rounded-full bg-slate-200 text-[#003366] border border-slate-300 flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">
          Vos
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
    }

    function formatInlineMarkdown(text: string): string {
      let escaped = escapeHtml(text);
      escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-gray-900">$1</strong>');
      escaped = escaped.replace(/(^|[^\*])\*([^\*\n]+)\*([^\*]|$)/g, '$1<em class="italic">$2</em>$3');
      escaped = escaped.replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 py-0.5 rounded text-[11px] font-mono">$1</code>');
      return escaped;
    }

    function formatAssistantContent(rawText: string): string {
      if (!rawText) return '';
      const clean = rawText.replace(/\r\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
      const paragraphs = clean.split(/\n\n+/);

      return paragraphs.map(p => {
        const lines = p.split('\n').map(l => l.trim()).filter(Boolean);
        const isBulletList = lines.length > 0 && lines.every(l => /^[-*•]\s+/.test(l));
        const isNumberedList = lines.length > 0 && lines.every(l => /^\d+[\.\)]\s+/.test(l));

        if (isBulletList) {
          const items = lines.map(l => {
            const itemText = formatInlineMarkdown(l.replace(/^[-*•]\s+/, ''));
            return `<li class="leading-snug">${itemText}</li>`;
          }).join('');
          return `<ul class="list-disc pl-5 my-1 space-y-0.5 text-xs sm:text-sm">${items}</ul>`;
        }

        if (isNumberedList) {
          const items = lines.map(l => {
            const itemText = formatInlineMarkdown(l.replace(/^\d+[\.\)]\s+/, ''));
            return `<li class="leading-snug">${itemText}</li>`;
          }).join('');
          return `<ol class="list-decimal pl-5 my-1 space-y-0.5 text-xs sm:text-sm">${items}</ol>`;
        }

        const formattedLines = lines.map(l => formatInlineMarkdown(l)).join('<br/>');
        return `<p class="mb-1.5 last:mb-0 leading-snug">${formattedLines}</p>`;
      }).join('');
    }

    function appendAssistantMessage(text: string, sources: string[]) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start gap-2.5';

      let sourcesHtml = '';
      if (sources && sources.length > 0) {
        const uniqueSources = Array.from(new Set(sources.filter(Boolean)));
        if (uniqueSources.length > 0) {
          sourcesHtml = `
            <div class="mt-2 pt-1.5 border-t border-slate-100">
              <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block mb-1">Fuentes de verificación:</span>
              <div class="flex flex-wrap gap-1">
                ${uniqueSources.map(s => {
                  const isLocal = s.startsWith('/contenido/');
                  const label = isLocal ? `Doc. ${s.replace('/contenido/', '')}` : s;
                  return `
                    <a href="${s}" class="inline-flex items-center gap-1 text-[11px] text-[#003366] bg-[#F0F5FA] hover:bg-[#E2EDF8] border border-[#01579B]/20 px-2 py-0.5 rounded transition">
                      <svg class="w-3 h-3 text-[#01579B] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                      ${escapeHtml(label)}
                    </a>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        }
      }

      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5 overflow-hidden p-0.5">
          <img src="/images/CURZAS.png" alt="IA" class="w-full h-full object-contain" />
        </div>
        <div class="bg-white border border-slate-200 rounded-xl rounded-tl-none px-3.5 py-2.5 max-w-3xl shadow-sm text-xs sm:text-sm text-slate-800 leading-snug">
          ${formatAssistantContent(text)}
          ${sourcesHtml}
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
    }

    function appendLoadingMessage(): string {
      const id = 'loading-' + Date.now();
      const msgDiv = document.createElement('div');
      msgDiv.id = id;
      msgDiv.className = 'flex items-start gap-2.5';
      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm mt-0.5 overflow-hidden p-0.5">
          <img src="/images/CURZAS.png" alt="IA" class="w-full h-full object-contain" />
        </div>
        <div class="bg-white border border-slate-200 rounded-xl rounded-tl-none px-3.5 py-2 max-w-2xl shadow-sm text-xs sm:text-sm text-slate-500 flex items-center gap-2">
          <svg class="animate-spin h-3.5 w-3.5 text-[#01579B]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          Pensando...
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
      return id;
    }

    function removeLoadingMessage(id: string) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }

    function appendErrorMessage(errorMsg: string) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start gap-2.5';
      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-red-600 text-white flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">
          !
        </div>
        <div class="bg-red-50 border border-red-200 rounded-xl rounded-tl-none px-3.5 py-2 max-w-2xl text-xs sm:text-sm text-red-800 leading-snug">
          ${escapeHtml(errorMsg)}
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
    }

    function scrollToBottom() {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
  </script>
</Layout>
