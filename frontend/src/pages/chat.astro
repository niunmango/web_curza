---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Asistente Virtual IA (RAG) - CURZA UNCo">
  <div class="max-w-4xl mx-auto px-3 sm:px-6 py-3 sm:py-4 flex flex-col h-[calc(100vh-9.5rem)] min-h-[460px]">
    <!-- Header Chat -->
    <div class="flex items-center justify-between pb-2.5 border-b border-gray-200 mb-3 flex-shrink-0">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-lg sm:text-xl font-bold text-gray-900 leading-tight">Asistente Virtual Institucional</h1>
          <span class="text-[11px] bg-emerald-100 text-emerald-800 font-semibold px-2 py-0.5 rounded-full border border-emerald-300">
            RAG Local CPU
          </span>
        </div>
        <p class="text-xs text-gray-500 mt-0.5">
          Respuestas fundamentadas en la base de conocimiento de CURZA indexada en Qdrant.
        </p>
      </div>

      <button id="clear-chat" class="text-xs text-gray-400 hover:text-gray-600 transition px-2 py-1 rounded hover:bg-gray-100">
        Limpiar chat
      </button>
    </div>

    <!-- Área de Mensajes -->
    <div id="chat-messages" class="flex-grow overflow-y-auto space-y-2.5 pr-2 pb-2 scroll-smooth">
      <!-- Mensaje Inicial del Asistente -->
      <div class="flex items-start gap-2.5">
        <div class="w-6 h-6 rounded-full bg-blue-900 text-white flex items-center justify-center text-[10px] font-bold flex-shrink-0 shadow-sm mt-0.5">
          IA
        </div>
        <div class="bg-white border border-gray-200 rounded-xl rounded-tl-none px-3.5 py-2.5 max-w-3xl shadow-sm text-xs sm:text-sm text-gray-800 leading-snug">
          <p class="mb-2">¡Hola! Soy el asistente institucional del CURZA (UNCo). Puedo orientarte sobre carreras, inscripciones, fechas de examen, normativas y vida estudiantil.</p>
          <div class="pt-2 border-t border-gray-100 flex flex-wrap items-center gap-1.5 text-xs">
            <span class="text-gray-400 text-[11px]">Sugerencias:</span>
            <button class="suggest-btn text-blue-700 bg-blue-50 hover:bg-blue-100 px-2 py-0.5 rounded transition text-xs">
              ¿Qué carreras se dictan en CURZA?
            </button>
            <button class="suggest-btn text-blue-700 bg-blue-50 hover:bg-blue-100 px-2 py-0.5 rounded transition text-xs">
              ¿Cómo realizo trámites en Bedelía?
            </button>
            <button class="suggest-btn text-blue-700 bg-blue-50 hover:bg-blue-100 px-2 py-0.5 rounded transition text-xs">
              ¿Cuáles son los requisitos de ingreso?
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Box -->
    <div class="pt-2.5 border-t border-gray-200 flex-shrink-0">
      <form id="chat-form" class="relative flex items-center">
        <textarea 
          id="chat-input"
          rows="1"
          placeholder="Escribí tu consulta institucional aquí..."
          class="w-full resize-none rounded-xl border border-gray-300 pl-3.5 pr-20 py-2 text-xs sm:text-sm focus:border-blue-600 focus:ring-1 focus:ring-blue-500 outline-none shadow-sm bg-white"
          required
        ></textarea>
        <button 
          type="submit" 
          id="send-btn"
          class="absolute right-1.5 px-3 py-1.5 bg-blue-800 hover:bg-blue-900 text-white font-medium rounded-lg text-xs sm:text-sm transition shadow-sm flex items-center gap-1"
        >
          <span>Enviar</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
      </form>
      <div class="text-[10px] text-gray-400 text-center mt-1">
        Respuestas generadas con IA institucional y contexto recuperado de Qdrant.
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLTextAreaElement;
    const messagesContainer = document.getElementById('chat-messages') as HTMLDivElement;
    const sendBtn = document.getElementById('send-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear-chat') as HTMLButtonElement;

    // Sugerencias de botones
    document.querySelectorAll('.suggest-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        input.value = (btn.textContent || '').trim();
        form.dispatchEvent(new Event('submit'));
      });
    });

    clearBtn?.addEventListener('click', () => {
      window.location.reload();
    });

    // Enviar con Enter (sin shift)
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.dispatchEvent(new Event('submit'));
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const prompt = input.value.trim();
      if (!prompt) return;

      input.value = '';
      input.disabled = true;
      sendBtn.disabled = true;

      // 1. Renderizar mensaje del usuario
      appendUserMessage(prompt);
      scrollToBottom();

      // 2. Renderizar indicador de carga
      const loadingId = appendLoadingMessage();
      scrollToBottom();

      try {
        const res = await fetch('/api/rag/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt })
        });

        removeLoadingMessage(loadingId);

        if (!res.ok) {
          throw new Error(`Error en servicio RAG (${res.status})`);
        }

        const data = await res.json();
        appendAssistantMessage(data.answer, data.sources || []);
      } catch (err: any) {
        removeLoadingMessage(loadingId);
        appendErrorMessage(err.message || 'No se pudo comunicar con el servicio de IA.');
      } finally {
        input.disabled = false;
        sendBtn.disabled = false;
        input.focus();
        scrollToBottom();
      }
    });

    function appendUserMessage(text: string) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start justify-end gap-2.5';
      msgDiv.innerHTML = `
        <div class="bg-blue-800 text-white rounded-xl rounded-tr-none px-3.5 py-2 max-w-2xl shadow-sm text-xs sm:text-sm leading-snug whitespace-pre-wrap">
          ${escapeHtml(text)}
        </div>
        <div class="w-6 h-6 rounded-full bg-slate-300 text-slate-700 flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">
          Tú
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
    }

    function formatInlineMarkdown(text: string): string {
      let escaped = escapeHtml(text);
      escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold text-gray-900">$1</strong>');
      escaped = escaped.replace(/(^|[^\*])\*([^\*\n]+)\*([^\*]|$)/g, '$1<em class="italic">$2</em>$3');
      escaped = escaped.replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 py-0.5 rounded text-[11px] font-mono">$1</code>');
      return escaped;
    }

    function formatAssistantContent(rawText: string): string {
      if (!rawText) return '';
      const clean = rawText.replace(/\r\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
      const paragraphs = clean.split(/\n\n+/);

      return paragraphs.map(p => {
        const lines = p.split('\n').map(l => l.trim()).filter(Boolean);
        const isBulletList = lines.length > 0 && lines.every(l => /^[-*•]\s+/.test(l));
        const isNumberedList = lines.length > 0 && lines.every(l => /^\d+[\.\)]\s+/.test(l));

        if (isBulletList) {
          const items = lines.map(l => {
            const itemText = formatInlineMarkdown(l.replace(/^[-*•]\s+/, ''));
            return `<li class="leading-snug">${itemText}</li>`;
          }).join('');
          return `<ul class="list-disc pl-5 my-1 space-y-0.5 text-xs sm:text-sm">${items}</ul>`;
        }

        if (isNumberedList) {
          const items = lines.map(l => {
            const itemText = formatInlineMarkdown(l.replace(/^\d+[\.\)]\s+/, ''));
            return `<li class="leading-snug">${itemText}</li>`;
          }).join('');
          return `<ol class="list-decimal pl-5 my-1 space-y-0.5 text-xs sm:text-sm">${items}</ol>`;
        }

        const formattedLines = lines.map(l => formatInlineMarkdown(l)).join('<br/>');
        return `<p class="mb-1.5 last:mb-0 leading-snug">${formattedLines}</p>`;
      }).join('');
    }

    function appendAssistantMessage(text: string, sources: string[]) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start gap-2.5';

      let sourcesHtml = '';
      if (sources && sources.length > 0) {
        const uniqueSources = Array.from(new Set(sources.filter(Boolean)));
        if (uniqueSources.length > 0) {
          sourcesHtml = `
            <div class="mt-2 pt-1.5 border-t border-gray-100">
              <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider block mb-1">Fuentes de verificación:</span>
              <div class="flex flex-wrap gap-1">
                ${uniqueSources.map(s => {
                  const isLocal = s.startsWith('/contenido/');
                  const label = isLocal ? `Doc. ${s.replace('/contenido/', '')}` : s;
                  return `
                    <a href="${s}" class="inline-flex items-center gap-1 text-[11px] text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200/60 px-2 py-0.5 rounded transition">
                      <svg class="w-3 h-3 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                      ${escapeHtml(label)}
                    </a>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        }
      }

      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-blue-900 text-white flex items-center justify-center text-[10px] font-bold flex-shrink-0 shadow-sm mt-0.5">
          IA
        </div>
        <div class="bg-white border border-gray-200 rounded-xl rounded-tl-none px-3.5 py-2.5 max-w-3xl shadow-sm text-xs sm:text-sm text-gray-800 leading-snug">
          ${formatAssistantContent(text)}
          ${sourcesHtml}
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
    }

    function appendLoadingMessage(): string {
      const id = 'loading-' + Date.now();
      const msgDiv = document.createElement('div');
      msgDiv.id = id;
      msgDiv.className = 'flex items-start gap-2.5';
      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-blue-900 text-white flex items-center justify-center text-[10px] font-bold flex-shrink-0 shadow-sm mt-0.5">
          IA
        </div>
        <div class="bg-white border border-gray-200 rounded-xl rounded-tl-none px-3.5 py-2 max-w-2xl shadow-sm text-xs sm:text-sm text-gray-500 flex items-center gap-2">
          <svg class="animate-spin h-3.5 w-3.5 text-blue-600" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          Generando respuesta...
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
      return id;
    }

    function removeLoadingMessage(id: string) {
      const el = document.getElementById(id);
      if (el) el.remove();
    }

    function appendErrorMessage(errorMsg: string) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start gap-2.5';
      msgDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-red-600 text-white flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">
          !
        </div>
        <div class="bg-red-50 border border-red-200 rounded-xl rounded-tl-none px-3.5 py-2 max-w-2xl text-xs sm:text-sm text-red-800 leading-snug">
          ${escapeHtml(errorMsg)}
        </div>
      `;
      messagesContainer.appendChild(msgDiv);
    }

    function scrollToBottom() {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
  </script>
</Layout>
