---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portal Institucional CURZAS - UNComa">
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-900 via-indigo-900 to-slate-900 text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center">
      <div class="inline-block bg-blue-800/60 border border-blue-700/50 rounded-full px-4 py-1 text-xs font-semibold tracking-wider uppercase mb-4 text-blue-200">
        Universidad Nacional del Comahue (UNComa)
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
        Complejo Universitario Regional <span class="text-amber-400">Zona Atlántica y Sur</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 mb-8 max-w-2xl mx-auto">
        Plataforma unificada de información académica, carreras, novedades institucionales y motor de búsqueda inteligente.
      </p>

      <!-- Buscador Principal Instantáneo -->
      <form action="/search" method="GET" class="max-w-2xl mx-auto relative flex items-center shadow-2xl">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input 
          type="text" 
          name="q" 
          placeholder="Buscar carreras, resoluciones, bedelía, trámites..." 
          class="w-full pl-11 pr-28 py-4 rounded-xl text-gray-900 bg-white border-0 focus:ring-4 focus:ring-blue-400 text-base shadow-sm outline-none"
          required
        />
        <button 
          type="submit" 
          class="absolute right-2 px-5 py-2.5 bg-blue-700 hover:bg-blue-800 text-white font-medium rounded-lg text-sm transition shadow-sm"
        >
          Buscar
        </button>
      </form>

      <!-- Chips de búsqueda rápida -->
      <div class="flex flex-wrap justify-center gap-2 mt-4 text-xs text-blue-200">
        <span>Búsquedas frecuentes:</span>
        <a href="/search?q=Enfermeria" class="hover:underline bg-white/10 px-2 py-0.5 rounded">Enfermería</a>
        <a href="/search?q=Psicopedagogia" class="hover:underline bg-white/10 px-2 py-0.5 rounded">Psicopedagogía</a>
        <a href="/search?q=Administracion" class="hover:underline bg-white/10 px-2 py-0.5 rounded">Administración Pública</a>
        <a href="/search?q=Bedelia" class="hover:underline bg-white/10 px-2 py-0.5 rounded">Bedelía</a>
      </div>
    </div>
  </section>

  <!-- Banner Asistente Virtual RAG -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6">
    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 rounded-2xl p-6 sm:p-8 text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 border border-blue-600">
      <div class="flex items-start gap-4">
        <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0 text-amber-300">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <div>
          <h3 class="text-xl font-bold">Asistente Virtual CURZAS</h3>
          <p class="text-sm text-blue-100 mt-1 max-w-xl">
            Realizá preguntas institucionales sobre planes de estudio, calendarios académicos e inscripciones. Respuestas automáticas con información oficial.
          </p>
        </div>
      </div>
      <a href="/chat" class="px-6 py-3 bg-white text-blue-900 font-bold rounded-xl hover:bg-blue-50 transition shadow-md whitespace-nowrap flex items-center gap-2">
        <span>Consultar al Asistente</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </section>

  <!-- Secciones Destacadas -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Accesos Directos y Gestión Institucional</h2>
      <p class="text-gray-500 text-sm mt-2">Navegación ágil a los departamentos del complejo</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Tarjeta Carreras -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition">
        <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Oferta Académica</h3>
        <p class="text-sm text-gray-600 mb-4">
          Licenciaturas, profesorados y tecnicaturas dictadas en el CURZAS, con planes de correlatividades y perfiles de egreso.
        </p>
        <a href="/search?q=carrera" class="text-sm font-semibold text-blue-700 hover:text-blue-900 flex items-center gap-1">
          Ver carreras indexadas &rarr;
        </a>
      </div>

      <!-- Tarjeta Bedelía & Alumnos -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition">
        <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Alumnos y Bedelía</h3>
        <p class="text-sm text-gray-600 mb-4">
          Inscripciones, exámenes finales, calendario académico, constancias y trámites estudiantiles.
        </p>
        <a href="/search?q=bedelia" class="text-sm font-semibold text-blue-700 hover:text-blue-900 flex items-center gap-1">
          Información de trámites &rarr;
        </a>
      </div>

      <!-- Tarjeta Bienestar y Comunidad -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm hover:shadow-md transition">
        <div class="w-10 h-10 rounded-lg bg-purple-100 text-purple-800 flex items-center justify-center mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Bienestar y Comunidad</h3>
        <p class="text-sm text-gray-600 mb-4">
          Becas, comedor, deportes, accesibilidad y actividades de extensión universitaria para estudiantes y docentes.
        </p>
        <a href="/search?q=bienestar" class="text-sm font-semibold text-blue-700 hover:text-blue-900 flex items-center gap-1">
          Ver novedades de bienestar &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
