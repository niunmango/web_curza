---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Búsqueda Instantánea - CURZAS UNComa">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Búsqueda Institucional</h1>
      <p class="text-gray-500 text-sm mt-1">
        Buscador de carreras, resoluciones, convocatorias, trámites y noticias del CURZAS.
      </p>
    </div>

    <!-- Buscador Input -->
    <div class="relative mb-6">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
      <input 
        id="search-input"
        type="text" 
        placeholder="Escribí para buscar (ej. Enfermería, Resolución, Inscripción, Bedelía)..." 
        class="w-full pl-11 pr-4 py-3.5 bg-white border border-gray-300 rounded-xl text-gray-900 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none shadow-sm text-base"
        autofocus
      />
    </div>

    <!-- Estado y estadísticas -->
    <div class="flex justify-between items-center text-xs text-gray-500 mb-4 px-1">
      <span id="search-status">Listo para buscar</span>
      <span id="search-stats"></span>
    </div>

    <!-- Contenedor de Resultados -->
    <div id="results-container" class="space-y-4">
      <div class="text-center py-12 text-gray-400 bg-white rounded-xl border border-dashed border-gray-200">
        <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        Ingresá un término para iniciar la búsqueda en los documentos indexados de CURZAS.
      </div>
    </div>
  </div>

  <script>
    const input = document.getElementById('search-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('results-container') as HTMLDivElement;
    const statusText = document.getElementById('search-status') as HTMLSpanElement;
    const statsText = document.getElementById('search-stats') as HTMLSpanElement;

    // Obtener parámetro inicial si existe
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery) {
      input.value = initialQuery;
      performSearch(initialQuery);
    }

    let debounceTimer: any;
    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(input.value.trim());
      }, 150);
    });

    async function performSearch(query: string) {
      if (!query) {
        resultsContainer.innerHTML = `
          <div class="text-center py-12 text-gray-400 bg-white rounded-xl border border-dashed border-gray-200">
            Ingresá un término para iniciar la búsqueda en los documentos indexados de CURZAS.
          </div>
        `;
        statusText.textContent = "Listo para buscar";
        statsText.textContent = "";
        return;
      }

      statusText.textContent = "Buscando...";
      const startTime = performance.now();

      try {
        const res = await fetch('/api/search/indexes/curza_content/search', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer meili_master_key_curza'
          },
          body: JSON.stringify({
            q: query,
            limit: 20,
            attributesToHighlight: ['title', 'content'],
            highlightPreTag: '<mark class="bg-amber-200 text-gray-900 font-semibold px-0.5 rounded">',
            highlightPostTag: '</mark>'
          })
        });

        if (!res.ok) {
          throw new Error(`Error en servidor de búsqueda (${res.status})`);
        }

        const data = await res.json();
        const duration = Math.round(performance.now() - startTime);
        const hits = data.hits || [];

        statusText.textContent = `${hits.length} resultado${hits.length === 1 ? '' : 's'} encontrado${hits.length === 1 ? '' : 's'}`;
        statsText.textContent = `Tiempo: ${data.processingTimeMs || duration} ms`;

        if (hits.length === 0) {
          resultsContainer.innerHTML = `
            <div class="p-8 text-center bg-white rounded-xl border border-gray-200 text-gray-500">
              No se encontraron coincidencias para <strong>"${escapeHtml(query)}"</strong>.
              <div class="text-xs text-gray-400 mt-2">
                Probá con sinónimos o consultá al <a href="/chat" class="text-blue-600 underline">Asistente IA</a>.
              </div>
            </div>
          `;
          return;
        }

        resultsContainer.innerHTML = hits.map((hit: any) => {
          const title = hit._formatted?.title || hit.title || 'Sin título';
          const content = hit._formatted?.content || hit.content || '';
          const snippet = content.length > 250 ? content.substring(0, 250) + '...' : content;
          const typeBadge = hit.type === 'page' ? 'Página Institucional' : 'Novedad / Noticia';
          const badgeClass = hit.type === 'page' ? 'bg-blue-50 text-blue-700 border-blue-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200';
          const localUrl = `/contenido/${hit.id}`;

          const isOld = hit.date && ((Date.now() - new Date(hit.date).getTime()) > 365 * 24 * 60 * 60 * 1000);
          const oldBadge = isOld ? `
            <span class="text-xs px-2 py-0.5 rounded-full font-medium bg-amber-50 text-amber-700 border border-amber-200">
              Antiguo
            </span>
          ` : '';

          return `
            <article class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm hover:shadow-md transition">
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="text-xs px-2 py-0.5 rounded-full font-medium border ${badgeClass}">
                  ${typeBadge}
                </span>
                ${oldBadge}
                ${hit.date ? `<span class="text-xs text-gray-400">${new Date(hit.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>` : ''}
              </div>
              <h2 class="text-lg font-bold text-gray-900 hover:text-blue-700 transition">
                <a href="${localUrl}">${title}</a>
              </h2>
              <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                ${snippet}
              </p>
              <div class="mt-4 flex items-center justify-between pt-3 border-t border-gray-100">
                <a href="${localUrl}" class="text-xs font-semibold text-blue-700 hover:text-blue-900 flex items-center gap-1">
                  Ver documento en el portal
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
                ${hit.original_url ? `
                  <a href="${hit.original_url}" target="_blank" rel="noopener noreferrer" class="text-[11px] text-gray-400 hover:text-gray-600">
                    Fuente original
                  </a>
                ` : ''}
              </div>
            </article>
          `;
        }).join('');

      } catch (err: any) {
        statusText.textContent = "Error al consultar el buscador";
        statsText.textContent = "";
        resultsContainer.innerHTML = `
          <div class="p-6 bg-red-50 border border-red-200 rounded-xl text-red-800 text-sm">
            <strong>Aviso de conexión:</strong> No se pudo consultar el motor de búsqueda en este momento.
          </div>
        `;
      }
    }

    function escapeHtml(str: string): string {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
  </script>
</Layout>
