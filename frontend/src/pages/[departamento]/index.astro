---
import Layout from '../../layouts/Layout.astro';
import departamentos from '../../data/departamentos.json';

export function getStaticPaths() {
  return departamentos.map((depto) => ({
    params: { departamento: depto.slug },
    props: { depto },
  }));
}

const { depto } = Astro.props;

// Filter degree careers vs intermediate titles if any
const carrerasGrado = depto.carreras.filter((c: any) => !c.es_titulo_intermedio);
const titulosIntermedios = depto.carreras.filter((c: any) => c.es_titulo_intermedio);
---

<Layout 
  title={`${depto.nombre} - CURZAS | UNComa`}
  description={`${depto.nombre} del Complejo Universitario Regional Zona Atlántica y Sur (UNComa). Carreras, planes de estudio, autoridades e información de contacto.`}
>
  <!-- Hero Banner del Departamento -->
  <section class="relative bg-gradient-to-b from-[#002B54] via-[#003366] to-[#002244] text-white pt-10 pb-14 px-4 sm:px-6 lg:px-8 border-b-4 border-[#F39200]">
    <div class="max-w-7xl mx-auto">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-300 mb-6">
        <a href="/" class="hover:text-white transition">Inicio</a>
        <span class="text-white/40">/</span>
        <a href="/#departamentos" class="hover:text-white transition">Departamentos</a>
        <span class="text-white/40">/</span>
        <span class="text-[#FFBC7D] font-medium">{depto.nombre_corto}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-[#FFBC7D] mb-3">
            <span>CURZAS · UNComa</span>
            <span class="text-white/40">·</span>
            <span>{depto.badge}</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-3">
            {depto.nombre}
          </h1>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed max-w-2xl">
            {depto.descripcion}
          </p>
        </div>

        <!-- Tarjeta Rápida de Autoridad -->
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-5 md:min-w-[280px] text-xs">
          <div class="text-[11px] font-bold uppercase tracking-wider text-[#FFBC7D] mb-1.5">
            {depto.cargo || 'Dirección del Departamento'}
          </div>
          <div class="text-base font-bold text-white mb-2">
            {depto.director || 'A confirmar'}
          </div>
          {depto.horario && (
            <div class="text-slate-300 flex items-center gap-1.5 mb-1.5">
              <svg class="w-4 h-4 text-[#FFBC7D] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>{depto.horario}</span>
            </div>
          )}
          {depto.email && (
            <a 
              href={`mailto:${depto.email}`} 
              class="text-white hover:text-[#FFBC7D] transition flex items-center gap-1.5 font-medium underline underline-offset-2 break-all"
            >
              <svg class="w-4 h-4 text-[#FFBC7D] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              <span>{depto.email}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Contenedor Principal: 2 Columnas -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Columna Principal (2 columnas): Carreras y Planes de Estudio -->
      <div class="lg:col-span-2 space-y-10">
        
        <!-- Sección Carreras de Grado y Pregrado -->
        <section id="carreras">
          <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-200">
            <div>
              <span class="text-xs font-bold text-[#F39200] uppercase tracking-wider block">Propuesta Formativa</span>
              <h2 class="text-2xl font-bold text-[#003366]">Carreras del Departamento</h2>
            </div>
            <span class="text-xs font-semibold bg-[#F0F5FA] text-[#003366] border border-blue-200 px-3 py-1 rounded-full">
              {carrerasGrado.length} {carrerasGrado.length === 1 ? 'Carrera' : 'Carreras'}
            </span>
          </div>

          <div class="space-y-6">
            {carrerasGrado.map((carrera: any) => (
              <div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden">
                <!-- Encabezado de la Carrera -->
                <div class="p-6 border-b border-slate-100 bg-[#FCFDFE]">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    {carrera.duracion_total_anos > 0 && (
                      <span class="bg-[#FFF8EE] text-[#F39200] border border-[#F39200]/30 font-bold text-xs px-2.5 py-0.5 rounded">
                        Duración: {carrera.duracion_total_anos} {carrera.duracion_total_anos === 1 ? 'año' : 'años'}
                      </span>
                    )}
                    {carrera.modalidades && carrera.modalidades.length > 0 && carrera.modalidades.map((m: string) => (
                      <span class="bg-[#F0F5FA] text-[#003366] border border-blue-100 font-semibold text-xs px-2.5 py-0.5 rounded">
                        {m} (Viedma)
                      </span>
                    ))}
                    {carrera.plan_vigente && (
                      <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 font-semibold text-xs px-2.5 py-0.5 rounded">
                        Plan Ord. {carrera.plan_vigente.ordenanza}
                      </span>
                    )}
                  </div>

                  <h3 class="text-xl font-bold text-[#003366] mb-2 leading-snug">
                    {carrera.nombre}
                  </h3>

                  <!-- Perfil sintético -->
                  {carrera.perfil && (
                    <div class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4" set:html={carrera.perfil} />
                  )}

                  <!-- Alcance del título si existe -->
                  {carrera.alcance && carrera.alcance !== carrera.perfil && (
                    <div class="bg-[#F8FAFC] border-l-2 border-[#0071A1] p-3 rounded-r text-xs text-slate-600 mb-4">
                      <span class="font-bold text-[#003366] block mb-1">Alcance y Campo Ocupacional:</span>
                      <div set:html={carrera.alcance} />
                    </div>
                  )}

                  <!-- Botones de Acción de la Carrera -->
                  <div class="flex flex-wrap items-center gap-3 pt-2">
                    <a 
                      href={`/${depto.slug}/carreras/${carrera.id}`}
                      class="px-4 py-2 bg-[#003366] hover:bg-[#01579B] text-white text-xs font-semibold rounded-lg transition flex items-center gap-1.5 shadow-sm"
                    >
                      <span>Ver Plan y Asignaturas</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    </a>

                    {carrera.brochure && (
                      <a 
                        href={carrera.brochure} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="px-4 py-2 bg-white hover:bg-slate-50 text-[#003366] border border-slate-300 text-xs font-semibold rounded-lg transition flex items-center gap-1.5"
                      >
                        <svg class="w-3.5 h-3.5 text-[#F39200]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        <span>Descargar Folleto PDF</span>
                      </a>
                    )}

                    {carrera.plan_vigente && carrera.plan_vigente.archivo && (
                      <a 
                        href={carrera.plan_vigente.archivo} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 text-xs font-medium rounded-lg transition flex items-center gap-1.5"
                      >
                        <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        <span>Ordenanza {carrera.plan_vigente.ordenanza} (PDF)</span>
                      </a>
                    )}
                  </div>
                </div>

                <!-- Resumen de materias / asignaturas -->
                {carrera.asignaturas && carrera.asignaturas.length > 0 && (
                  <details class="group border-t border-slate-100">
                    <summary class="p-3.5 px-6 text-xs font-semibold text-[#0071A1] hover:text-[#003366] cursor-pointer flex items-center justify-between bg-slate-50/50 hover:bg-slate-50 transition select-none">
                      <span class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                        <span>Ver lista de asignaturas ({carrera.asignaturas.length} materias)</span>
                      </span>
                      <span class="text-xs group-open:rotate-180 transition-transform">▼</span>
                    </summary>
                    <div class="p-5 bg-white border-t border-slate-100">
                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        {carrera.asignaturas.map((asig: any, index: number) => (
                          <div class="p-2.5 rounded bg-slate-50 border border-slate-100 flex items-start gap-2">
                            <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 flex items-center justify-center font-bold text-[10px] flex-shrink-0 mt-0.5">
                              {index + 1}
                            </span>
                            <div>
                              <span class="font-medium text-slate-800 block">{asig.nombre}</span>
                              <span class="text-[10px] text-slate-400">
                                {asig.codigo ? `Cód: ${asig.codigo}` : ''} 
                                {asig.horas ? ` · ${asig.horas} hs` : ''}
                              </span>
                            </div>
                          </div>
                        ))}
                      </div>
                      <div class="mt-4 text-center">
                        <a 
                          href={`/${depto.slug}/carreras/${carrera.id}`}
                          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#003366] hover:text-[#01579B] transition uppercase tracking-wider"
                        >
                          <span>Ver ficha completa con correlatividades y régimen</span>
                          &rarr;
                        </a>
                      </div>
                    </div>
                  </details>
                )}
              </div>
            ))}
          </div>
        </section>

        <!-- Títulos Intermedios / Diplomaturas si existen -->
        {titulosIntermedios.length > 0 && (
          <section id="intermedios" class="bg-slate-50 rounded-xl p-6 border border-slate-200">
            <h3 class="text-lg font-bold text-[#003366] mb-3 flex items-center gap-2">
              <svg class="w-5 h-5 text-[#F39200]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
              <span>Títulos Intermedios y Certificaciones</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {titulosIntermedios.map((t: any) => (
                <div class="bg-white p-4 rounded-lg border border-slate-200 shadow-sm">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#01579B] bg-blue-50 px-2 py-0.5 rounded">
                    Título Intermedio {t.duracion_total_anos > 0 ? `· ${t.duracion_total_anos} años` : ''}
                  </span>
                  <h4 class="font-bold text-sm text-[#003366] mt-2 mb-1">{t.nombre}</h4>
                  {t.perfil && <div class="text-xs text-slate-500" set:html={t.perfil} />}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Novedades del Departamento -->
        {depto.posts && depto.posts.length > 0 && (
          <section id="novedades">
            <div class="mb-5 pb-2 border-b border-slate-200">
              <span class="text-xs font-bold text-[#F39200] uppercase tracking-wider block">Actualidad y Eventos</span>
              <h2 class="text-2xl font-bold text-[#003366]">Novedades de {depto.nombre_corto}</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {depto.posts.map((post: any) => (
                <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between">
                  <div>
                    {post.thumbnail && (
                      <div class="h-36 overflow-hidden bg-slate-100">
                        <img 
                          src={post.thumbnail} 
                          alt={post.title} 
                          class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="p-4">
                      {post.date && (
                        <span class="text-[11px] text-slate-400 font-medium block mb-1">
                          {new Date(post.date).toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}
                        </span>
                      )}
                      <h4 class="font-bold text-sm text-[#003366] mb-2 leading-snug">
                        {post.title}
                      </h4>
                      {post.excerpt && (
                        <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
                          {post.excerpt}
                        </p>
                      )}
                    </div>
                  </div>
                  <div class="p-4 pt-0">
                    <a 
                      href={`/search?q=${encodeURIComponent(post.title)}`}
                      class="text-xs font-semibold text-[#0071A1] hover:text-[#003366] flex items-center gap-1"
                    >
                      <span>Leer más</span>
                      &rarr;
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

      </div>

      <!-- Barra Lateral / Sidebar (1 columna) -->
      <aside class="space-y-6">
        
        <!-- Tarjeta Institucional de Contacto y Equipo -->
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm border-t-4 border-t-[#003366]">
          <h3 class="font-bold text-base text-[#003366] mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <svg class="w-5 h-5 text-[#0071A1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            <span>Información del Departamento</span>
          </h3>

          <div class="space-y-4 text-xs">
            <div>
              <span class="text-slate-400 block font-medium uppercase text-[10px] tracking-wider mb-0.5">
                {depto.cargo || 'Dirección'}
              </span>
              <span class="font-bold text-slate-800 text-sm block">
                {depto.director}
              </span>
            </div>

            {depto.auxiliar && (
              <div>
                <span class="text-slate-400 block font-medium uppercase text-[10px] tracking-wider mb-0.5">
                  Equipo / Auxiliares
                </span>
                <span class="text-slate-700 block leading-relaxed">
                  {depto.auxiliar}
                </span>
              </div>
            )}

            {depto.horario && (
              <div>
                <span class="text-slate-400 block font-medium uppercase text-[10px] tracking-wider mb-0.5">
                  Horario de Atención
                </span>
                <span class="text-slate-700 block font-medium">
                  {depto.horario}
                </span>
              </div>
            )}

            {depto.email && (
              <div>
                <span class="text-slate-400 block font-medium uppercase text-[10px] tracking-wider mb-0.5">
                  Correo Electrónico
                </span>
                <a 
                  href={`mailto:${depto.email}`} 
                  class="font-semibold text-[#0071A1] hover:underline break-all block"
                >
                  {depto.email}
                </a>
              </div>
            )}

            {depto.telefono && (
              <div>
                <span class="text-slate-400 block font-medium uppercase text-[10px] tracking-wider mb-0.5">
                  Teléfono
                </span>
                <span class="text-slate-700 font-medium block">
                  {depto.telefono}
                </span>
              </div>
            )}

            {depto.redes && depto.redes.length > 0 && (
              <div>
                <span class="text-slate-400 block font-medium uppercase text-[10px] tracking-wider mb-1">
                  Redes Oficiales
                </span>
                <div class="flex flex-col gap-1.5">
                  {depto.redes.map((r: any) => (
                    <a 
                      href={r.url} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-[#0071A1] hover:text-[#003366] font-medium flex items-center gap-1.5"
                    >
                      <span>{r.nombre}:</span>
                      <span class="underline">{r.usuario}</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <!-- Banner Asistente IA Específico del Departamento -->
        <div class="bg-gradient-to-br from-[#003366] to-[#002244] text-white rounded-xl p-5 shadow-sm border border-[#003366]">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[10px] font-bold uppercase tracking-wider bg-[#F39200] text-[#002244] px-2 py-0.5 rounded">
              Asistente IA CURZAS
            </span>
          </div>
          <h4 class="font-bold text-sm mb-1.5">¿Dudas sobre {depto.nombre_corto}?</h4>
          <p class="text-xs text-slate-200 mb-4 leading-relaxed">
            Preguntale a nuestro Asistente Virtual sobre requisitos de inscripción, correlatividades de materias, fechas de finales y planes de estudio.
          </p>
          <a 
            href={`/chat?q=¿Cuáles son las carreras y planes del ${depto.nombre}?`}
            class="w-full text-center px-4 py-2.5 bg-white text-[#003366] hover:bg-slate-100 font-bold text-xs rounded-lg transition block shadow-sm"
          >
            Consultar al Asistente IA &rarr;
          </a>
        </div>

        <!-- Accesos Directos del Estudiante -->
        <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400 mb-3">Accesos para Estudiantes</h4>
          <div class="space-y-2.5 text-xs">
            <a 
              href="http://siucurza.uncoma.edu.ar/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="p-2.5 rounded-lg border border-slate-200 hover:border-[#0071A1] hover:bg-slate-50 transition flex items-center justify-between group"
            >
              <span class="font-semibold text-slate-700 group-hover:text-[#0071A1]">SIU Guaraní CURZAS</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#0071A1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a 
              href="https://pedco.uncoma.edu.ar/course/index.php?categoryid=6" 
              target="_blank" 
              rel="noopener noreferrer"
              class="p-2.5 rounded-lg border border-slate-200 hover:border-[#003366] hover:bg-slate-50 transition flex items-center justify-between group"
            >
              <span class="font-semibold text-slate-700 group-hover:text-[#003366]">PEDCO · Aulas Virtuales</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#003366]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a 
              href="/plano" 
              class="p-2.5 rounded-lg border border-slate-200 hover:border-[#F39200] hover:bg-slate-50 transition flex items-center justify-between group"
            >
              <span class="font-semibold text-slate-700 group-hover:text-[#F39200]">Plano de Aulas y Sede</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#F39200]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>

        <!-- Otros Departamentos Académicos -->
        <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm">
          <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400 mb-3">Otros Departamentos</h4>
          <div class="space-y-1.5 text-xs">
            {departamentos.filter(d => d.slug !== depto.slug).map(d => (
              <a 
                href={`/${d.slug}`}
                class="py-1.5 px-2 rounded hover:bg-slate-100 text-slate-700 hover:text-[#003366] flex items-center justify-between transition"
              >
                <span>{d.nombre_corto}</span>
                <span class="text-slate-400">&rarr;</span>
              </a>
            ))}
          </div>
        </div>

      </aside>

    </div>
  </div>
