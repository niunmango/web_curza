---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "CURZAS - Universidad Nacional del Comahue (UNComa)",
  description = "Portal institucional del Complejo Universitario Regional Zona Atlántica y Sur"
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col font-sans">
    <!-- Header / Navbar -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-3">
            <a href="/" class="flex items-center space-x-2">
              <span class="text-2xl font-black tracking-tight text-blue-900">CURZAS</span>
              <span class="text-xs uppercase bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded">UNComa</span>
            </a>
          </div>

          <!-- Navegación -->
          <nav class="hidden md:flex space-x-6 text-sm font-medium text-gray-600">
            <a href="/" class="hover:text-blue-900 transition">Inicio</a>
            <a href="/search" class="hover:text-blue-900 transition flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              Búsqueda
            </a>
            <a href="/chat" class="hover:text-blue-900 transition flex items-center gap-1 text-blue-700 font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Asistente IA (RAG)
            </a>
          </nav>

          <!-- Botón rápido búsqueda móvil -->
          <div class="flex items-center gap-2 md:hidden">
            <a href="/search" class="p-2 text-gray-600 hover:text-blue-900">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </a>
            <a href="/chat" class="p-2 text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-300 py-10 mt-16 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-white font-bold text-lg mb-2">CURZAS - UNComa</h3>
            <p class="text-sm text-slate-400">
              Complejo Universitario Regional Zona Atlántica y Sur.<br />
              Universidad Nacional del Comahue.<br />
              Viedma, Río Negro, Argentina.
            </p>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-2">Servicios del Portal</h4>
            <ul class="space-y-1 text-sm text-slate-400">
              <li><a href="/search" class="hover:text-white transition">Búsqueda Instantánea (Meilisearch)</a></li>
              <li><a href="/chat" class="hover:text-white transition">Asistente Virtual RAG (Qdrant + FastEmbed)</a></li>
              <li><a href="/admin" class="hover:text-white transition">Gestión Editorial (Strapi v5)</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-2">Entorno</h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              Plataforma desacoplada, arquitectura de contenedores con motor de búsqueda semántica y procesamiento en CPU local.
            </p>
          </div>
        </div>
        <div class="mt-8 pt-6 border-t border-slate-800 text-center text-xs text-slate-500">
          &copy; {new Date().getFullYear()} CURZAS - UNComa. Plataforma Modernizada.
        </div>
      </div>
    </footer>
  </body>
</html>
