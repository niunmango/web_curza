---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "CURZAS - Universidad Nacional del Comahue (UNComa)",
  description = "Portal institucional del Complejo Universitario Regional Zona Atlántica y Sur"
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/CURZAS.png" />
    <title>{title}</title>
    <!-- Google Fonts Poppins (Tipografía Institucional UNComa) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8FAFC] text-[#313131] min-h-screen flex flex-col font-sans antialiased">
    <!-- Franja Superior Institucional UNComa -->
    <div class="bg-[#002B54] text-white text-[11px] py-1.5 px-4 sm:px-6 lg:px-8 border-b border-[#01579B]/30">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div class="flex items-center gap-2">
          <span class="font-bold tracking-wider uppercase text-[#FFBC7D]">UNComa</span>
          <span class="text-white/30">|</span>
          <span class="text-slate-200 hidden sm:inline font-normal">Universidad Nacional del Comahue · República Argentina</span>
        </div>
        <div class="flex items-center gap-4 text-slate-300">
          <a href="https://uncoma.edu.ar" target="_blank" rel="noopener noreferrer" class="hover:text-white transition flex items-center gap-1 font-medium">
            <span>uncoma.edu.ar</span>
            <svg class="w-3 h-3 text-[#FFBC7D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Header Principal / Navbar -->
    <header class="bg-white border-b border-slate-200/80 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3.5 group">
              <!-- Logotipo Oficial CURZAS -->
              <img 
                src="/images/CURZAS.png" 
                alt="Logo Oficial CURZAS - Universidad Nacional del Comahue" 
                class="h-12 w-auto object-contain transition-transform group-hover:scale-105"
                width="48"
                height="48"
              />
              <div class="border-l-2 border-slate-200 pl-3 py-0.5">
                <span class="text-sm font-extrabold text-[#003366] tracking-tight block leading-tight">
                  CURZAS
                </span>
                <span class="text-[10px] font-semibold text-[#F39200] tracking-wider block uppercase leading-tight">
                  Universidad Nacional del Comahue
                </span>
              </div>
            </a>
          </div>

          <!-- Navegación -->
          <nav class="hidden md:flex items-center space-x-7 text-[13px] font-semibold text-[#153D66]">
            <a href="/" class="hover:text-[#01579B] transition py-1 border-b-2 border-transparent hover:border-[#F39200]">Inicio</a>
            <a href="/search" class="hover:text-[#01579B] transition flex items-center gap-1.5 py-1 border-b-2 border-transparent hover:border-[#F39200]">
              <svg class="w-4 h-4 text-[#01579B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              Búsqueda
            </a>
            <a href="/plano" class="hover:text-[#01579B] transition flex items-center gap-1 py-1 border-b-2 border-transparent hover:border-[#F39200]">
              <svg class="w-4 h-4 text-[#01579B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
              Plano CURZAS
            </a>
            <a href="/chat" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-[#003366] hover:bg-[#01579B] text-white font-medium text-xs transition shadow-sm border border-[#002244]">
              <svg class="w-3.5 h-3.5 text-[#FFBC7D]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
              <span>Asistente IA</span>
            </a>
          </nav>

          <!-- Botón móvil -->
          <div class="flex items-center gap-2 md:hidden">
            <a href="/search" class="p-2 text-slate-600 hover:text-[#003366]" title="Búsqueda">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </a>
            <a href="/plano" class="p-2 text-slate-600 hover:text-[#003366]" title="Plano CURZAS">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path></svg>
            </a>
            <a href="/chat" class="p-2 text-[#003366]" title="Asistente IA">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Institucional UNComa -->
    <footer class="mt-20">
      <!-- Línea dorada de acento institucional UNComa -->
      <div class="h-1.5 bg-[#F39200]"></div>
      
      <div class="bg-[#002244] text-slate-300 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Columna 1: Identidad, Dirección y Redes Sociales -->
            <div class="md:col-span-2">
              <div class="flex items-center gap-3 mb-4">
                <img 
                  src="/images/logo_blanco.png" 
                  alt="Logo CURZAS" 
                  class="h-12 w-auto object-contain opacity-95" 
                  width="48" 
                  height="48" 
                />
                <div>
                  <span class="text-white font-extrabold text-lg tracking-wide block leading-none">CURZAS</span>
                  <span class="text-[#FFBC7D] text-xs font-semibold tracking-wider uppercase block mt-1">Universidad Nacional del Comahue</span>
                </div>
              </div>
              <h3 class="text-white font-semibold text-sm mb-2">
                Complejo Universitario Regional Zona Atlántica y Sur
              </h3>
              <div class="text-xs text-slate-300 space-y-1 mb-4">
                <p class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#FFBC7D] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  <span>Monseñor Esandi y Ayacucho. Viedma (8500), Río Negro, Argentina.</span>
                </p>
                <p class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[#FFBC7D] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                  <span>Teléfonos: +54-2920-422921 / 423772</span>
                </p>
              </div>

              <!-- Enlaces Oficiales a Redes Sociales -->
              <div class="pt-2">
                <span class="text-[11px] font-bold text-[#FFBC7D] uppercase tracking-wider block mb-2">Seguinos en Redes Sociales:</span>
                <div class="flex items-center gap-3">
                  <!-- Instagram -->
                  <a 
                    href="https://www.instagram.com/curzasunco/" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-[#E1306C] hover:text-white transition text-xs font-medium text-slate-200 border border-white/10"
                    title="Instagram oficial CURZAS"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    <span>Instagram</span>
                  </a>
                  <!-- Facebook -->
                  <a 
                    href="https://www.facebook.com/curzasuncoma" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-[#1877F2] hover:text-white transition text-xs font-medium text-slate-200 border border-white/10"
                    title="Facebook oficial CURZAS"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
                    <span>Facebook</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Columna 2: Servicios -->
            <div>
              <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3 text-[#FFBC7D]">Servicios y Accesos</h4>
              <ul class="space-y-2 text-xs text-slate-300">
                <li><a href="http://siucurza.uncoma.edu.ar/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition hover:underline font-semibold text-[#FFBC7D]">SIU Guaraní &rarr;</a></li>
                <li><a href="https://pedco.uncoma.edu.ar/course/index.php?categoryid=6" target="_blank" rel="noopener noreferrer" class="hover:text-white transition hover:underline font-semibold text-[#FFBC7D]">PEDCO (Campus Virtual) &rarr;</a></li>
                <li><a href="/plano" class="hover:text-white transition hover:underline">Plano CURZAS</a></li>
                <li><a href="/search" class="hover:text-white transition hover:underline">Búsqueda de Contenidos</a></li>
                <li><a href="/chat" class="hover:text-white transition hover:underline flex items-center gap-1">
                  <span>Asistente IA</span>
                  <span class="text-[10px] bg-[#01579B] text-white px-1.5 rounded">Nuevo</span>
                </a></li>
                <li><a href="/search?q=carrera" class="hover:text-white transition hover:underline">Oferta Académica</a></li>
                <li><a href="/search?q=bedelia" class="hover:text-white transition hover:underline">Bedelía y Alumnos</a></li>
              </ul>
            </div>

            <!-- Columna 3: Enlaces Institucionales -->
            <div>
              <h4 class="text-white font-semibold text-xs uppercase tracking-wider mb-3 text-[#FFBC7D]">Universidad</h4>
              <ul class="space-y-2 text-xs text-slate-300">
                <li><a href="https://uncoma.edu.ar" target="_blank" rel="noopener noreferrer" class="hover:text-white transition hover:underline flex items-center gap-1">
                  <span>Portal Central UNComa</span>
                  <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </a></li>
                <li><a href="/search?q=resolucion" class="hover:text-white transition hover:underline">Boletín Oficial y Resoluciones</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra Inferior de Copyright -->
      <div class="bg-[#001730] py-4 border-t border-white/5 text-center text-xs text-slate-400">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-2">
          <span>&copy; {new Date().getFullYear()} CURZAS - Universidad Nacional del Comahue.</span>
          <span class="text-slate-500 text-[11px]">Plataforma Digital Institucional · Viedma, Río Negro</span>
        </div>
      </div>
    </footer>
  </body>
</html>
